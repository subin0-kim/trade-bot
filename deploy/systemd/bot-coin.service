[Unit]
Description=코인봇 1사이클 (⚠️ LIVE 실계좌) + 대시보드 갱신
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trading
WorkingDirectory=/opt/stock-trade-bot
Environment=TZ=Asia/Seoul
Environment=UPBIT_CONFIG_PATH=/etc/trading/upbit.yaml
Environment=KIS_CONFIG_PATH=/etc/trading/kis_devlp.yaml
# --budget은 원장 초기 시드(원) — 이후 사이징은 원장 자산 비례 복리. ⚠️ 첫 실행 때 원장(data/state)이 이 값으로 생성되며,
# 이후 변경은 state 파일의 cash를 직접 수정해야 한다 (--budget만 바꿔선 반영 안 됨)
# --live --yes: 실계좌 실주문, 무인 확인 생략. dry-run으로 되돌리려면 두 플래그 제거 후
# 원장 보관 (모드 불일치 시 봇이 기동 거부 — README-deploy.md '실전 전환' 참고)
ExecStart=/bin/bash -lc 'uv run bot-coin --live --yes --budget 10000000 && uv run dashboard-build'
TimeoutStartSec=600
